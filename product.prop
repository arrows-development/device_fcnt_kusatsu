# Esim
masterclear.allow_retain_esim_profiles_after_fdr=true

# Bluetooth
bluetooth.device_id.vendor_id=0x0046
bluetooth.device.class_of_device=90,2,12

# Camera
persist.vendor.camera.privapp.list=org.lineageos.aperture,com.motorola.camera5
vendor.camera.aux.packagelist=org.lineageos.aperture,com.motorola.camera5

# FM
ro.fm.band=3
ro.fm.chip=0x6631
ro.fm.fake_chan_0=9210 -205
ro.fm.fake_chan_1=9600 -152
ro.fm.fake_chan_2=10400 -152
ro.fm.fake_chan_3=10750 -205
ro.fm.fake_chans=4
ro.fm.high_band=1080
ro.fm.low_band=760
ro.fm.seek_space=1
ro.fm.short_ana_sup=1

# RKP
remote_provisioning.hostname=remoteprovisioning.googleapis.com
remote_provisioning.tee.rkp_only=1

# Skia tracing
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false

import /product/product.${ro.boot.product.hardware.sku}.prop
